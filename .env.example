# No API keys, CSD or PAC are required. These variables only matter when running
# the HTTP (self-hosted) transport.

# Transport: "stdio" (default, for Claude Desktop / Claude Code) or "http".
TRANSPORT=stdio

# HTTP transport only. Safe by default: loopback bind, localhost Host/Origin only.
PORT=3000
HOST=127.0.0.1
# Hostnames the Host header may carry when exposed (e.g. mcp.example.com).
ALLOWED_HOSTS=
# Origins allowed to call from a browser.
ALLOWED_ORIGINS=
# If set, every request needs "Authorization: Bearer <token>". Set it before exposing
# the server: an open instance relays requests to the SAT for anyone.
MCP_AUTH_TOKEN=
# Largest CFDI accepted, in characters, and CFDI calls served at once.
MAX_XML_CHARS=2000000
MAX_CONCURRENT_CFDI=4
