# Interim image for the pre-npm window: build from the PARENT directory so the
# `file:../mx-identifiers` dependency resolves.
#
#   docker build -f mx-fiscal-mcp-server/Dockerfile.local -t mx-fiscal-mcp ..
#
# Delete this file once `mx-identifiers` is on npm and package.json points at
# `^1.0.0` — the plain Dockerfile then covers every case.

FROM node:22-alpine AS build
WORKDIR /build
COPY mx-identifiers ./mx-identifiers
COPY mx-fiscal-mcp-server/package*.json ./mx-fiscal-mcp-server/
WORKDIR /build/mx-fiscal-mcp-server
RUN npm ci --ignore-scripts
COPY mx-fiscal-mcp-server/tsconfig.json ./
COPY mx-fiscal-mcp-server/src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV TRANSPORT=http
ENV PORT=3000
COPY --from=build /build/mx-identifiers /mx-identifiers
COPY --from=build /build/mx-fiscal-mcp-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /build/mx-fiscal-mcp-server/dist ./dist
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s \
  CMD wget -qO- http://127.0.0.1:3000/healthz || exit 1
CMD ["node", "dist/index.js"]
