{
  "name": "mx-fiscal-mcp-server",
  "version": "1.0.2",
  "description": "MCP server for Mexican tax and banking data — validate RFC, CURP, CLABE and NSS, read CFDI 4.0 invoices, query the SAT status service and look up SAT catalogues. Read-only, no API keys required.",
  "mcpName": "io.github.OrtaMarco/mx-fiscal-mcp-server",
  "type": "module",
  "bin": {
    "mx-fiscal-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test scripts/units.test.mjs",
    "smoke": "node scripts/smoke-all.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mexico",
    "mexican",
    "sat",
    "cfdi",
    "rfc",
    "curp",
    "clabe",
    "nss",
    "imss",
    "banxico",
    "factura",
    "facturacion-electronica",
    "test-data"
  ],
  "author": "Marco Orta <contacto@ortamarco.me> (https://ortamarco.me)",
  "license": "MIT",
  "homepage": "https://github.com/OrtaMarco/mx-fiscal-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrtaMarco/mx-fiscal-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/OrtaMarco/mx-fiscal-mcp-server/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@xmldom/xmldom": "^0.9.8",
    "express": "^5.2.1",
    "mx-identifiers": "^1.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
